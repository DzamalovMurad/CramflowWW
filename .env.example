# Пример окружения Flowix. Скопируйте в .env для локальной разработки
# (.env в .gitignore) и задайте эти же переменные в Railway → Variables.
# Полное описание с последствиями «если не задать» — в README.

# ── Обязательные ───────────────────────────────────────────────────────────

# Подключение к PostgreSQL. На Railway: ${{Postgres.DATABASE_URL}}.
# Без неё сервис не стартует.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowix?sslmode=disable

# Токен бота от @BotFather. Без него не работают ни бот, ни оформление
# заказов (подпись initData проверяется этим же токеном).
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram user_id администраторов через запятую (узнать: @userinfobot).
# Без них некому получать заказы и недоступны команды бота.
TELEGRAM_ADMIN_IDS=111111111,222222222

# ── Настраиваемые ──────────────────────────────────────────────────────────

# Публичный https-адрес сервиса: Mini App, webhook, кнопка меню бота.
# На Railway подставляется автоматически из RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=https://flowix.up.railway.app

# Секрет webhook (заголовок X-Telegram-Bot-Api-Secret-Token и путь).
# Если не задан — генерируется на время работы процесса.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# webhook (по умолчанию) | polling. Без PUBLIC_URL автоматически polling.
BOT_MODE=webhook

# Где хранить фото товаров: db (по умолчанию) | local.
# local без подключённого Railway Volume теряет фото при каждом редеплое.
UPLOAD_STORE=db
UPLOAD_DIR=./uploads

# Порт HTTP-сервера. Railway подставляет свой.
PORT=8080

# Собранный фронтенд (в Docker-образе выставлен автоматически).
WEB_DIST=./web/dist

# Часовой пояс магазина: от него зависят даты доставки и «сегодня на базе».
APP_TIMEZONE=Europe/Moscow

# Часы приёма доставки (местное время магазина).
SHOP_OPEN_HOUR=9
SHOP_CLOSE_HOUR=21

# Ежедневный дамп БД в Telegram админам.
BACKUP_ENABLED=true
BACKUP_HOUR=4
